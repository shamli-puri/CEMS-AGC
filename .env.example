# --- CEMS - AGC Campus Event Management System ---------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-this-with-a-long-random-string

# Database (defaults to SQLite in instance/cems_agc.sqlite3)
# DATABASE_URL=sqlite:///instance/cems_agc.sqlite3

# Seeding / demo data on first run
DB_AUTO_CREATE=1
SEED_ON_START=1

# Uploads
UPLOAD_FOLDER=static/uploads

# Email (optional - the app runs fine with email disabled)
MAIL_ENABLED=0
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=cems.agc@example.com
MAIL_LOG_FILE=instance/emails.log